# Your Convex deployment URL (packages/backend/.env.local -> CONVEX_URL after `pnpm dev:backend`)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Optional. Leave empty to run in demo mode without sign-in.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Web app URL, used to build "Share trip" links
EXPO_PUBLIC_WEB_URL=http://localhost:3000
